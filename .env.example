# Local project configuration
# Fill in your API key and adjust the optional budget if needed.

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5.4-mini
# Optional: use a different model for image-first extraction/classification.
# If omitted, the chat model is reused for vision calls.
# OPENAI_VISION_MODEL=gpt-5.4-mini
# Optional: allow OpenAI to fetch remote image URLs directly.
# Default behavior is safer inline-only image upload from this scraper process.
# OPENAI_VISION_REMOTE_URLS=false
# Optional: enable the run-scoped field-contract runtime path.
# Recommended on in development/testing while the migration is underway.
# Default is false.
# RUN_SCOPED_SCHEMA_ENABLED=false

# Optional batch budget guardrail in USD
OPENAI_MAX_COST_USD=1.50

# Optional manual price overrides. Leave commented to use built-in pricing.
# OPENAI_EMBEDDING_COST_PER_1M_TOKENS=
# OPENAI_CHAT_INPUT_COST_PER_1M_TOKENS=
# OPENAI_CHAT_OUTPUT_COST_PER_1M_TOKENS=
